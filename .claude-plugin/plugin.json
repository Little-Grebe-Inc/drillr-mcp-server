  "keywords": [
    "mcp",
    "finance",
    "sec-filings",
    "alternative-data",
    "agentic-research",
    "llm-native"
  ],
  "mcpServers": {
    "drillr": {
      "type": "http",
      "url": "https://gateway.drillr.ai/mcp/data",
      "headers": {
        "Authorization": "Bearer ${DRILLR_API_KEY}"
      }
    }
  }
}
