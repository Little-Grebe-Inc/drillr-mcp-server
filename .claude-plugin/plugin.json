{
  "name": "drillr",
  "description": "Drillr financial MCP for AI agents — standardized financial data, SEC filings semantic search, live signals, and 24 alt-data categories. One HTTP MCP server (gateway.drillr.ai/mcp/data) exposing 8 tools.",
  "version": "1.0.0",
  "author": {
    "name": "Little Grebe Inc."
  },
  "homepage": "https://drillr.ai",
